# Caddy gets and renews the HTTPS certificate for DOMAIN from Let's Encrypt automatically,
# redirects http to https, and forwards everything to the app (ADR-034), except /mcp, which goes to
# the MCP server for agents (ADR-041).
{$DOMAIN} {
	# Not compressed: MCP answers can be an event stream, and compression would hold it back.
	handle /mcp* {
		reverse_proxy mcp:8080
	}

	handle {
		encode zstd gzip
		reverse_proxy app:8080
	}
}
